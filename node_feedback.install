<?php

/**
 * @file
 * Node Feedback module schema hooks.
 */

/**
 * Implements hook_schema().
 */
function node_feedback_schema() {
  $schema = array();

  $schema['node_feedback'] = array(
    'description' => 'Node Feedback entries.',
    'fields' => array(
      'nfid' => array(
        'description' => 'The unique ID for this particular flag.',
        'type' => 'serial',
        'size' => 'small',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'nid' => array(
        'description' => 'The unique ID of the node.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'name' => array(
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Unique user name.',
      ),
      'response_text_feedback' => array(
        'description' => 'The response text feedback of this flag if any.',
        'type' => 'text',
        'not null' => FALSE,
      ),
      'timestamp' => array(
        'description' => 'The UNIX time stamp representing when the flag was set.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('nfid'),
  );

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function node_feedback_uninstall() {
  // Remove default, un-modified views.
  $configs = array(
    'views.view.node_feedback_stats',
    'views.view.node_feedback_report',
  );
  foreach ($configs as $file) {
    $config = config($file);
    if ($config->get('storage') != VIEWS_STORAGE_OVERRIDE) {
      $config->delete();
    }
  }
}

/**
 * Move book settings from variables to config.
 */
function node_feedback_update_1000() {
  // Migrate variables to config.
  $config = config('node_feedback.settings');
  $config->set('nf_header_text', update_variable_get('nf_header_text', ''));
  $config->set('nf_yes_text', update_variable_get('nf_yes_text', 'yes'));
  $config->set('nf_button_text', update_variable_get('nf_button_text', 'no'));
  $config->set('nf_yes_message', update_variable_get('nf_yes_message', 'Thanks for your feedback!'));
  $config->set('nf_thanks_message', update_variable_get('nf_thanks_message', 'Thanks for your feedback!'));
  $config->set('nf_feedback_title', update_variable_get('nf_feedback_title', 'Tell us more..'));
  $config->set('nf_allowed_content_type', update_variable_get('nf_allowed_content_type', array()));
  $config->set('nf_show_stats', update_variable_get('nf_show_stats', array()));

  $config->save();

  // Delete variables.
  update_variable_del('nf_header_text');
  update_variable_del('nf_yes_text');
  update_variable_del('nf_button_text');
  update_variable_del('nf_yes_message');
  update_variable_del('nf_thanks_message');
  update_variable_del('nf_feedback_title');
  update_variable_del('nf_allowed_content_type');
  update_variable_del('nf_show_stats');
}

/**
 * Update node feedback views to include node title field.
 */
function node_feedback_update_1001() {
  // Load and update the node_feedback_stats view
  $view_stats = config('views.view.node_feedback_stats');
  if ($view_stats && !$view_stats->isNew()) {
    // Get current fields
    $fields = $view_stats->get('display.default.display_options.fields');

    // Create title field definition
    $title_field = array(
      'id' => 'title',
      'table' => 'node',
      'field' => 'title',
      'relationship' => 'nid',
      'group_type' => 'group',
      'ui_name' => '',
      'label' => 'Node Title',
      'exclude' => 0,
      'alter' => array(
        'alter_text' => 0,
        'text' => '',
        'make_link' => 1,
        'path' => '',
        'absolute' => 0,
        'external' => 0,
        'replace_spaces' => 0,
        'path_case' => 'none',
        'trim_whitespace' => 0,
        'alt' => '',
        'rel' => '',
        'link_class' => '',
        'prefix' => '',
        'suffix' => '',
        'target' => '',
        'nl2br' => 0,
        'max_length' => '',
        'word_boundary' => 1,
        'ellipsis' => 1,
        'more_link' => 0,
        'more_link_text' => '',
        'more_link_path' => '',
        'strip_tags' => 0,
        'trim' => 0,
        'preserve_tags' => '',
        'html' => 0,
      ),
      'element_type' => '',
      'element_class' => '',
      'element_label_type' => '',
      'element_label_class' => '',
      'element_label_colon' => 1,
      'element_wrapper_type' => '',
      'element_wrapper_class' => '',
      'element_default_classes' => 1,
      'empty' => '',
      'hide_empty' => 0,
      'empty_zero' => 0,
      'hide_alter_empty' => 1,
      'link_to_node' => 1,
    );

    // Reorder fields: nfid, title, then the rest
    $new_fields = array();
    foreach ($fields as $field_name => $field_config) {
      $new_fields[$field_name] = $field_config;
      // After nfid, insert the title field
      if ($field_name === 'nfid') {
        $new_fields['title'] = $title_field;
      }
    }

    // Update relationships to ensure node relationship exists
    $relationships = $view_stats->get('display.default.display_options.relationships');
    if (!isset($relationships['nid'])) {
      $relationships['nid'] = array(
        'id' => 'nid',
        'table' => 'node_feedback',
        'field' => 'nid',
        'relationship' => 'none',
        'group_type' => 'group',
        'ui_name' => '',
        'label' => 'Node',
        'required' => 0,
      );
    }

    // Update style options to include the new field in the correct position
    $style_options = $view_stats->get('display.default.display_options.style_options');
    $style_options['columns']['title'] = 'title';
    $style_options['info']['title'] = array(
      'sortable' => 1,
      'default_sort_order' => 'asc',
      'align' => '',
      'separator' => '',
      'empty_column' => 0,
    );

    // Save the updated configuration
    $view_stats->set('display.default.display_options.fields', $new_fields);
    $view_stats->set('display.default.display_options.relationships', $relationships);
    $view_stats->set('display.default.display_options.style_options', $style_options);
    $view_stats->save();
  }

  // Load and update the node_feedback_report view
  $view_report = config('views.view.node_feedback_report');
  if ($view_report && !$view_report->isNew()) {
    // Get current fields
    $fields = $view_report->get('display.default.display_options.fields');

    // Create title field definition
    $title_field = array(
      'id' => 'title',
      'table' => 'node',
      'field' => 'title',
      'relationship' => 'nid',
      'group_type' => 'group',
      'ui_name' => '',
      'label' => 'Node Title',
      'exclude' => 0,
      'alter' => array(
        'alter_text' => 0,
        'text' => '',
        'make_link' => 1,
        'path' => '',
        'absolute' => 0,
        'external' => 0,
        'replace_spaces' => 0,
        'path_case' => 'none',
        'trim_whitespace' => 0,
        'alt' => '',
        'rel' => '',
        'link_class' => '',
        'prefix' => '',
        'suffix' => '',
        'target' => '',
        'nl2br' => 0,
        'max_length' => '',
        'word_boundary' => 1,
        'ellipsis' => 1,
        'more_link' => 0,
        'more_link_text' => '',
        'more_link_path' => '',
        'strip_tags' => 0,
        'trim' => 0,
        'preserve_tags' => '',
        'html' => 0,
      ),
      'element_type' => '',
      'element_class' => '',
      'element_label_type' => '',
      'element_label_class' => '',
      'element_label_colon' => 1,
      'element_wrapper_type' => '',
      'element_wrapper_class' => '',
      'element_default_classes' => 1,
      'empty' => '',
      'hide_empty' => 0,
      'empty_zero' => 0,
      'hide_alter_empty' => 1,
      'link_to_node' => 1,
    );

    // Reorder fields: timestamp, nfid, title, then the rest
    $new_fields = array();
    foreach ($fields as $field_name => $field_config) {
      $new_fields[$field_name] = $field_config;
      // After nfid, insert the title field
      if ($field_name === 'nfid') {
        $new_fields['title'] = $title_field;
      }
    }

    // Update relationships to ensure node relationship exists
    $relationships = $view_report->get('display.default.display_options.relationships');
    if (!isset($relationships['nid'])) {
      $relationships['nid'] = array(
        'id' => 'nid',
        'table' => 'node_feedback',
        'field' => 'nid',
        'relationship' => 'none',
        'group_type' => 'group',
        'ui_name' => '',
        'label' => 'Node',
        'required' => 0,
      );
    }

    // Update style options to include the new field in the correct position
    $style_options = $view_report->get('display.default.display_options.style_options');
    $style_options['columns']['title'] = 'title';
    $style_options['info']['title'] = array(
      'sortable' => 1,
      'default_sort_order' => 'asc',
      'align' => '',
      'separator' => '',
      'empty_column' => 0,
    );

    // Save the updated configuration
    $view_report->set('display.default.display_options.fields', $new_fields);
    $view_report->set('display.default.display_options.relationships', $relationships);
    $view_report->set('display.default.display_options.style_options', $style_options);
    $view_report->save();
  }

  // Clear views cache to ensure changes take effect
  if (function_exists('views_invalidate_cache')) {
    views_invalidate_cache();
  }

  return t('Node Feedback views updated to include node title field.');
}
